# Chép file này thành .env rồi điền giá trị.
# App ID / App Secret: developers.facebook.com → app của bạn → App settings → Basic
FB_APP_ID=
FB_APP_SECRET=

# Hai dòng dưới tool tự điền khi bạn bấm "Kết nối" ở http://localhost:3000/setup.html
FB_PAGE_ID=
FB_PAGE_TOKEN=

# Tuỳ chọn
# FB_GRAPH_VERSION=v21.0
# PORT=3000
